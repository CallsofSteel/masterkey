      "callShape": "POST https://api.strale.io/x402/invoice-validate with JSON body {invoice:{...invoice fields...}}",
      "inputExample": {
        "invoice": {
          "invoice_number": "INV-001",
          "invoice_date": "2026-06-08",
          "vendor_name": "Acme Co",
          "vendor_vat": "DE123456789",
          "vendor_address": "1 Main St, Berlin",
          "line_items": [
            {
              "description": "Service",
              "quantity": 1,
              "unit_price": 100,
              "line_total": 100
